{
  "version": 2,
  "outputDirectory": "public",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/health",   "dest": "/api/index.js" },
    { "src": "/(.*)",     "dest": "/$1" }
  ]
}
